{
  "name": "interface-archaeology",
  "version": "0.1.0",
  "private": true,
  "description": "Understand the code beneath the interface. Static analysis and interactive architecture maps for React and Next.js codebases.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 4310",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 4310",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "analyze": "node --experimental-strip-types --no-warnings scripts/analyze.ts",
    "screenshots": "node --experimental-strip-types --no-warnings scripts/screenshots.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@xyflow/react": "^13.0.3",
    "lucide-react": "^1.78.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^29.1.1",
    "vitest": "^5.1.1"
  }
}
